{
  "name": "digital-cell-pro",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "DIGITAL CELL PRO — gestión de taller, inventario, facturación y caja",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "deploy": "npm run build && firebase deploy",
    "e2e": "node e2e/run.mjs",
    "test:rules": "npm i --no-save @firebase/rules-unit-testing@3 && npx -y firebase-tools@13 emulators:exec --only firestore --project demo-rules \"node e2e/rules.mjs\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.4.0",
    "firebase": "10.14.1",
    "lucide-react": "0.441.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.26.2",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "4.3.2",
    "typescript": "5.6.2",
    "vite": "5.4.8",
    "vitest": "2.1.2"
  }
}
