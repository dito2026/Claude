rules_version = '2';

// DIGITAL CELL PRO — reglas de seguridad por rol.
// Roles: admin · cajero · tecnico (campo `role` en users/{uid}).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function profilePath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function profile() { return get(profilePath()).data; }
    function hasProfile() { return signedIn() && exists(profilePath()); }
    function active() { return hasProfile() && profile().active == true; }
    function role() { return profile().role; }
    function isAdmin() { return active() && role() == 'admin'; }
    function isCashier() { return active() && role() in ['admin', 'cajero']; }
    function isStaff() { return active() && role() in ['admin', 'cajero', 'tecnico']; }
    function bootstrapPath() { return /databases/$(database)/documents/meta/bootstrap; }

    // ---- Primer administrador (solo una vez, en base vacía) ----
    match /meta/bootstrap {
      allow read: if signedIn();
      allow create: if signedIn()
        && !exists(bootstrapPath())
        && getAfter(profilePath()).data.role == 'admin'
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Puntero a la caja abierta (meta/cash.openSessionId)
    match /meta/cash {
      allow read: if isStaff();
      allow write: if isCashier();
    }

    // ---- Usuarios ----
    match /users/{uid} {
      allow read: if isStaff() || (signedIn() && request.auth.uid == uid);
      allow create: if isAdmin()
        || (signedIn() && request.auth.uid == uid
            && !exists(bootstrapPath())
            && existsAfter(bootstrapPath())
            && request.resource.data.role == 'admin');
      allow update: if isAdmin();
      allow delete: if false; // se desactivan, no se borran
    }

    // ---- Clave de la IA (Claude): la usa el personal, solo el admin la cambia ----
    match /secrets/ai {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // ---- Configuración ----
    match /settings/{doc} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // ---- Consecutivos: solo incrementos de 1 ----
    match /counters/{name} {
      allow read: if isStaff();
      allow create: if isStaff() && request.resource.data.value == 1;
      allow update: if isStaff() && request.resource.data.value == resource.data.value + 1;
      allow delete: if false;
    }

    // ---- Técnicos ----
    match /technicians/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // ---- Vendedores (comisiones) ----
    match /sellers/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // ---- Clientes ----
    match /customers/{id} {
      allow read: if isStaff();
      allow create, update: if isCashier();
      allow delete: if isAdmin();
    }

    // ---- Inventario ----
    // Los técnicos actualizan solo el stock (al usar repuestos en una OT).
    match /products/{id} {
      allow read: if isStaff();
      allow delete: if isAdmin();
      // el cajero puede crear un celular nuevo (sin stock) al comprar un usado
      allow create: if isAdmin()
        || (isCashier() && request.resource.data.type == 'EQUIPO' && request.resource.data.stock == 0);
      allow update: if isCashier()
        || (isStaff() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'updatedAt']));
    }

    // Kardex: solo se agregan registros
    match /stockMovements/{id} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if false;
    }

    // ---- Servicio técnico ----
    match /repairOrders/{id} {
      allow read: if isStaff();
      allow create: if isCashier();
      allow update: if isCashier()
        || (active() && role() == 'tecnico' && resource.data.technicianUserId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ---- Recordatorios: los crea, marca y elimina cualquiera del personal ----
    match /reminders/{id} {
      allow read, create, update, delete: if isStaff();
    }

    match /tickets/{id} {
      allow read, create, update: if isStaff();
      allow delete: if isAdmin();
    }

    // ---- Facturación y caja ----
    match /invoices/{id} {
      allow read, create: if isCashier();
      // Solo se permite anular (admin). Nunca borrar.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'voidReason', 'voidedAt', 'voidedBy', 'updatedAt']);
      allow delete: if false;
    }

    match /cashSessions/{id} {
      allow read, create, update: if isCashier();
      allow delete: if false;
    }

    // ---- Celulares por IMEI ----
    // phoneUnits/{IMEI}: un documento por equipo; imeiIndex/{IMEI} reserva cada IMEI (principal y secundario)
    match /phoneUnits/{imei} {
      allow read: if isStaff();
      allow create, update: if isCashier();
      allow delete: if false;
    }
    match /imeiIndex/{imei} {
      allow read: if isStaff();
      allow create: if isCashier() && !exists(/databases/$(database)/documents/imeiIndex/$(imei));
      // solo para volver a ingresar un IMEI cuyo equipo quedó anulado
      allow update: if isCashier()
        && get(/databases/$(database)/documents/phoneUnits/$(resource.data.unitId)).data.status == 'anulado';
      allow delete: if false;
    }

    // ---- Compras y proveedores ----
    match /suppliers/{id} {
      allow read, create, update: if isCashier();
      allow delete: if false; // se desactivan, no se borran
    }

    // Compras: no se borran; solo se actualizan los abonos
    match /purchases/{id} {
      allow read, create: if isCashier();
      // Abonos y corrección de proveedor: cajero o admin. Anular: solo admin.
      allow update: if (isCashier()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paid', 'payments', 'status', 'updatedAt', 'supplierId', 'supplierName', 'note'])
          && request.resource.data.status != 'anulada')
        || (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'voidReason', 'voidedAt', 'voidedBy', 'updatedAt'])
          && request.resource.data.status == 'anulada')
        // Editar productos, cantidades y costos: solo admin, guardando el historial en `edits`
        || (isAdmin()
          && resource.data.status != 'anulada'
          && request.resource.data.status != 'anulada'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['items', 'total', 'status', 'invoiceRef', 'note', 'dueDate', 'edits', 'updatedAt'])
          && request.resource.data.edits.size() == resource.data.get('edits', []).size() + 1);
      allow delete: if false;
    }

    // Remisiones (consignación): se crean y se actualizan al devolver o facturar; nunca se borran
    match /remissions/{id} {
      allow read, create, update: if isCashier();
      allow delete: if false;
    }

    // Contratos de compraventa de usados: solo se agregan
    match /usedPurchases/{id} {
      allow read, create: if isCashier();
      // solo para marcarlo «Fuera de caja» (cuando se descontó de la caja por error)
      allow update: if (isCashier()
        && resource.data.get('outsideCash', false) == false
        && request.resource.data.outsideCash == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['outsideCash', 'cashReversedAt', 'cashReversedBy', 'updatedAt']))
        // corregir datos del contrato (admin), guardando el historial en `edits`
        || (isAdmin() && resource.data.get('status', '') != 'anulado'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['date', 'city', 'seller', 'buyer', 'device', 'price', 'method', 'salePrice', 'edits', 'updatedAt'])
          && request.resource.data.edits.size() == resource.data.get('edits', []).size() + 1
          && request.resource.data.device.imei == resource.data.device.imei)
        // anular (admin)
        || (isAdmin() && resource.data.get('status', '') != 'anulado'
          && request.resource.data.status == 'anulado'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'voidReason', 'voidedAt', 'voidedBy', 'updatedAt']));
      allow delete: if false;
    }

    // Libro de caja: solo se agregan registros. Única excepción: corregir un gasto,
    // dejando los valores anteriores en `edits` (cajero: turno abierto; admin: cualquiera).
    match /cashMovements/{id} {
      allow read, create: if isCashier();
      allow update: if isCashier()
        && resource.data.direction == 'egreso'
        && resource.data.category == 'gasto'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['amount', 'method', 'description', 'expenseCategory', 'edits', 'updatedAt'])
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.method != 'Crédito tienda'
        && request.resource.data.edits.size() == resource.data.get('edits', []).size() + 1
        && (isAdmin() || get(/databases/$(database)/documents/meta/cash).data.openSessionId == resource.data.sessionId);
      allow delete: if false;
    }
  }
}
