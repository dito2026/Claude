# Copie este archivo como .env.local y complete con los datos de su proyecto Firebase
# (Consola Firebase → Configuración del proyecto → Tus apps → SDK web).
# Si se dejan vacías, la app arranca en MODO DEMO (datos guardados solo en este navegador).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
